NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
SESSION_SECRET=
# Production requires a dedicated, empty MySQL database. Never reuse a WordPress database.
# MYSQL_URL=mysql://USER:URL_ENCODED_PASSWORD@HOST:3306/DATABASE
# MYSQL_SSL=true
# Hostinger's proxy behavior must be verified before production.
TRUST_PROXY_HOPS=0
SQLITE_PATH=var/development.sqlite
