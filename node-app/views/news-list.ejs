<%- include('header') %><div class="news-workspace"><section class="news-list-header"><div><span class="news-eyebrow">GRAMASWARAJ NEWSROOM</span><h1><%= personal?'My news / എന്റെ വാർത്തകൾ':'News desk / വാർത്താ ഡെസ്ക്' %></h1><p><%= personal?'Create a story. Track its journey. / വാർത്ത തയ്യാറാക്കാം; നില അറിയാം.':'Review local stories from your permitted jurisdiction. / നിങ്ങളുടെ പരിധിയിലെ വാർത്തകൾ പരിശോധിക്കാം.' %></p></div><% if(personal){ %><a class="news-button news-button-primary" href="/my/news/new/">+ New story / പുതിയ വാർത്ത</a><% } %></section><form class="news-list-filter" method="get"><label for="news-status-filter">Status / നില</label><select class="news-input" name="status" id="news-status-filter"><option value="">All stories / എല്ലാ വാർത്തകളും</option><% Object.entries(newsStatuses).filter(([key])=>personal||key!=='DRAFT').forEach(([key,label])=>{ %><option value="<%= key %>" <%= status===key?'selected':'' %>><%= label %></option><% }) %></select><button class="news-button news-button-secondary">Apply / കാണിക്കുക</button></form><div class="news-story-grid"><% rows.forEach(article=>{ %><article class="news-story-card"><div class="news-story-top"><span class="news-status news-status-<%= article.status.toLowerCase() %>"><%= newsStatuses[article.status] %></span><small><%= article.number %></small></div><h2><a href="<%= personal?'/my/news/':'/news/' %><%= article.id %>/"><%= article.heading||'Untitled story / തലക്കെട്ടില്ലാത്ത കരട്' %></a></h2><p><%= article.content.slice(0,180) %><%= article.content.length>180?'…':'' %></p><div class="news-story-meta"><span>⌖ <%= article.panchayat_name %></span><span><%= article.programme_date||'Date not set' %></span></div><div class="news-story-bottom"><span><%= article.author_name %></span><a href="<%= personal?'/my/news/':'/news/' %><%= article.id %>/">Open story / കാണുക →</a></div></article><% }) %></div><% if(!rows.length){ %><section class="news-empty"><span aria-hidden="true">▧</span><h2><%= personal?'Your next local story starts here.':'No stories match this selection.' %></h2><p lang="ml"><%= personal?'നിങ്ങളുടെ ആദ്യ വാർത്ത തയ്യാറാക്കാം.':'ഈ നിലയിൽ വാർത്തകൾ ലഭ്യമല്ല.' %></p><% if(personal){ %><a class="news-button news-button-primary" href="/my/news/new/">Create a story / വാർത്ത തയ്യാറാക്കുക</a><% } %></section><% } %><p class="news-pagination"><%= total %> stories · Page <%= page %> of <%= pages %><% if(page>1){ %> <a href="?page=<%= page-1 %>&status=<%= status %>">← Previous</a><% } %><% if(page<pages){ %> <a href="?page=<%= page+1 %>&status=<%= status %>">Next →</a><% } %></p></div><%- include('footer') %>