<%- include('header') %><h1>Welcome, <%= user.username %></h1><p>Current coverage and registration activity within your jurisdiction.</p><div class="stats"><% [['Grama Panchayats',summary.panchayats],['Active facilitators',summary.active],['Primary coverage',summary.coverage+'%'],['Covered panchayats',summary.covered],['Vacant panchayats',summary.vacant],['Pending applications',summary.pending],['Total applications',summary.applications],['Suspended facilitators',summary.suspended],['Expired facilitators',summary.expired],['Expiring in 30 days',summary.expiring],['Districts',summary.districts],['Blocks',summary.blocks]].forEach(([label,value])=>{ %><section class="panel"><strong class="stat-value"><%= value %></strong><span><%= label %></span></section><% }) %></div><p class="mt-3">Coverage requires an active primary facilitator. Application counts include only records you may review.</p><section class="panel mt-4"><h2>Coverage by district</h2><div class="table-responsive"><table class="table"><thead><tr><th>District</th><th>Panchayats</th><th>Active facilitators</th><th>Covered</th><th>Vacant</th><th>Coverage</th><th>Pending</th></tr></thead><tbody><% districts.forEach(d=>{ %><tr><td><%= d.name %></td><td><%= d.panchayats %></td><td><%= d.active %></td><td><%= d.covered %></td><td><%= d.vacant %></td><td><%= d.coverage %>%</td><td><%= d.pending %></td></tr><% }) %></tbody></table></div><p><a class="btn btn-primary" href="/reports/">Open reports</a> <a class="btn btn-outline-primary" href="/reports/?report=vacancies">View vacancies</a></p></section><%- include('footer') %>