<div class="report-filters"><label>Training title / പരിശീലനത്തിന്റെ പേര് *<input class="form-control" name="title" required maxlength="180" value="<%= values.title||'' %>"></label><label>Trainer / പരിശീലകൻ<input class="form-control" name="trainer" maxlength="180" value="<%= values.trainer||'' %>"></label><label>Date / തീയതി *<input class="form-control" type="date" name="session_date" required value="<%= values.session_date %>"></label><label>Start time (IST) / ആരംഭ സമയം *<input class="form-control" type="time" name="starts_at" required value="<%= values.starts_at %>"></label><label>End time (IST) / അവസാന സമയം *<input class="form-control" type="time" name="ends_at" required value="<%= values.ends_at %>"></label><label>Mode / രീതി<select class="form-select" name="mode"><% [['OFFLINE','In person / നേരിട്ട്'],['ONLINE','Online / ഓൺലൈൻ'],['HYBRID','Hybrid / രണ്ടും']].forEach(([key,label])=>{ %><option value="<%= key %>" <%= values.mode===key?'selected':'' %>><%= label %></option><% }) %></select></label></div><label class="mt-3">Venue / meeting details / സ്ഥലം അല്ലെങ്കിൽ ഓൺലൈൻ മീറ്റിംഗ് വിവരങ്ങൾ *<textarea class="form-control mb-3" name="venue" required maxlength="500"><%= values.venue||'' %></textarea></label><label>Instructions / നിർദേശങ്ങൾ<textarea class="form-control mb-3" name="description" maxlength="2000"><%= values.description||'' %></textarea></label>