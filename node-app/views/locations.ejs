<%- include('header') %><h1>Location directory</h1><form class="search" method="get"><label class="visually-hidden" for="q">Search locations</label><input class="form-control" id="q" name="q" maxlength="100" value="<%= q %>" placeholder="Search district, block or panchayat"><button class="btn btn-primary">Search</button></form><p><%= rows.length %> Grama Panchayats</p><div class="panel table-responsive"><table class="table"><thead><tr><th>District</th><th>Block</th><th>Grama Panchayat</th><th>Code</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%= r.district_name %></td><td><%= r.block_name %></td><td><%= r.name %><% if(r.name_ml){ %><br><span lang="ml"><%= r.name_ml %></span><% } %></td><td><%= r.code %></td></tr><% }) %></tbody></table><% if(!rows.length){ %><p>No matching locations.</p><% } %></div><%- include('footer') %>