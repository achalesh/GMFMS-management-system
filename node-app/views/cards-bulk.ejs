<%- include('header') %><h1>Bulk download ID cards</h1><p><a href="/facilitators/">Back to Facilitators</a></p><p>Select up to 100 current issued cards within your jurisdiction. Generate cards from each facilitator’s ID card page if they are missing or outdated.</p><form method="post" class="panel"><input type="hidden" name="csrf" value="<%= csrf %>"><div class="table-responsive"><table class="table"><thead><tr><th>Select</th><th>Name</th><th>Panchayat</th><th>Card</th><th>Preview</th></tr></thead><tbody><% rows.forEach(card=>{ %><tr><td><input type="checkbox" name="card_ids" value="<%= card.id %>" aria-label="Select <%= card.f.full_name %>"></td><td><%= card.f.full_name %></td><td><%= card.f.panchayat_name %></td><td><%= card.number %></td><td><a href="/facilitators/<%= card.f.id %>/cards/">Preview card</a></td></tr><% }) %></tbody></table></div><% if(!rows.length){ %><p>No current issued cards available.</p><% }else{ %><label for="bulk-reason">Download reason *</label><input id="bulk-reason" class="form-control mb-3" name="reason" required maxlength="2000"><button class="btn btn-primary" name="format" value="pdf">Download selected cards PDF</button> <button class="btn btn-outline-primary" name="format" value="print_pdf">Download selected A4 print sheets</button><% } %></form><%- include('footer') %>