<%- include('header') %><h1>Audit history</h1><p>Page <%= page %>. Actions are read-only.</p><div class="panel table-responsive"><table class="table"><thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Record</th><th>Reason</th><th>Details</th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><td><%= new Date(row.created_at).toISOString() %></td><td><%= row.username||'Applicant / system' %></td><td><%= row.action %></td><td><%= row.entity||'—' %></td><td><%= row.reason||'—' %></td><td><%= row.changes||'—' %></td></tr><% }) %></tbody></table></div><nav class="pagination-links mt-3" aria-label="Audit pages"><% if(page>1){ %><a href="?page=<%= page-1 %>">Previous</a><% } %><% if(more){ %><a href="?page=<%= page+1 %>">Next</a><% } %></nav><%- include('footer') %>