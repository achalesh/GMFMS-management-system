<%- include('header') %><div class="news-workspace"><a class="news-back" href="<%= personal?'/my/news/':'/news/' %>">← <%= personal?'My news / എന്റെ വാർത്തകൾ':'News desk / വാർത്താ ഡെസ്ക്' %></a><article class="news-surface news-article"><div class="news-story-top"><span class="news-status news-status-<%= article.status.toLowerCase() %>"><%= newsStatuses[article.status] %></span><small><%= article.number %></small></div><h1><%= article.heading||'Untitled story / തലക്കെട്ടില്ലാത്ത കരട്' %></h1><div class="news-article-meta"><span><strong><%= article.author_name %></strong></span><span>⌖ <%= article.panchayat_name %> · <%= article.district_name %></span><span>Programme date / പരിപാടിയുടെ തീയതി: <%= article.programme_date||'—' %></span></div><% if(editable){ %><p><a class="news-button news-button-primary" href="/my/news/<%= article.id %>/edit/">Edit story / വാർത്ത തിരുത്തുക</a></p><% } %><div class="news-article-body"><%= article.content||'No content yet.' %></div><div class="news-tags"><% article.tags.forEach(tag=>{ %><span><%= tag %></span><% }) %></div><% if(media.length){ %><h2>Photos & video / ചിത്രങ്ങളും വീഡിയോയും</h2><div class="news-attachment-grid"><% media.forEach(file=>{const url=mediaBase+file.id; %><div class="news-media-tile"><% if(file.kind==='VIDEO'){ %><video controls playsinline preload="metadata" src="<%= url %>"></video><% }else{ %><a href="<%= url %>" target="_blank" rel="noopener"><img src="<%= url %>" alt="News image from <%= article.panchayat_name %>" loading="lazy"></a><% } %><a class="news-download" href="<%= url %>?download=1">Download <%= file.kind==='VIDEO'?'video / വീഡിയോ':'image / ചിത്രം' %></a></div><% }) %></div><% } %><p class="news-private-note">This submission is held in the newsroom. Approval does not automatically publish it on an external website. / ഈ വാർത്ത വാർത്താ ഡെസ്കിൽ സൂക്ഷിച്ചിരിക്കുന്നു; പുറത്തുള്ള വെബ്‌സൈറ്റിൽ സ്വയം പ്രസിദ്ധീകരിക്കില്ല.</p></article>
<% if(mayReview&&['SUBMITTED','APPROVED'].includes(article.status)){ %><section class="news-surface"><h2>Editorial review / വാർത്ത പരിശോധിക്കുക</h2><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= article.revision %>"><label class="news-field" for="news-review-note">Feedback / നിർദേശം *<textarea class="news-input" id="news-review-note" name="reason" rows="3" required maxlength="2000"></textarea></label><div class="news-submit-actions"><% if(article.status==='SUBMITTED'){ %><button class="news-button news-button-primary" name="action" value="approve">Approve / അംഗീകരിക്കുക</button><% } %><button class="news-button news-button-secondary" name="action" value="changes">Request changes / തിരുത്തൽ ആവശ്യപ്പെടുക</button><% if(article.status==='SUBMITTED'){ %><button class="news-button news-button-danger" name="action" value="reject">Reject / നിരസിക്കുക</button><% } %></div></form></section><% } %><section class="news-surface"><h2>Story updates / വാർത്തയുടെ നില</h2><div class="news-timeline"><% events.forEach(event=>{ %><div><span class="news-timeline-dot"></span><strong><%= newsStatuses[event.to_status] %></strong><time><%= new Date(Number(event.created_at)).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'}) %> IST</time><p><%= event.note %></p></div><% }) %></div></section></div><%- include('footer') %>