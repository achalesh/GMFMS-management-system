<% fields.forEach(f=>{ %><div class="mb-3"><% if(f.multiple){ %><fieldset><legend class="fs-6"><%= f.label %><%= f.required?' *':'' %></legend><div class="choices"><% f.options.forEach((option,i)=>{ %><label><input type="checkbox" name="<%= f.name %>" value="<%= option %>" <%= (Array.isArray(values[f.name])?values[f.name]:[values[f.name]]).includes(option)?'checked':'' %>> <%= option %></label><% }) %></div></fieldset><% }else{ %><label for="<%= f.name %>"><%= f.label %><%= f.required?' *':'' %></label><% if(f.options){ %><select class="form-select" id="<%= f.name %>" name="<%= f.name %>"><% f.options.forEach(option=>{ %><option value="<%= option %>" <%= values[f.name]===option?'selected':'' %>><%= option||'Prefer not to say' %></option><% }) %></select><% }else if(f.type==='textarea'){ %><textarea class="form-control" id="<%= f.name %>" name="<%= f.name %>" maxlength="<%= f.max %>" rows="3" <%= f.required?'required':'' %>><%= values[f.name]||'' %></textarea><% }else{ %><input class="form-control" type="<%= f.type %>" id="<%= f.name %>" name="<%= f.name %>" maxlength="<%= f.max %>" value="<%= values[f.name]??(f.name==='years_experience'?'0':'') %>" <%= f.required?'required':'' %> <% if(f.type==='number'){ %>min="0" max="80"<% } %>><% } %><% } %></div><% }) %>