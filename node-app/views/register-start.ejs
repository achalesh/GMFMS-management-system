<%- include('header') %><section class="panel login"><p class="eyebrow"><%= bi("JOIN GRAMASWARAJ") %></p><h1><%= bi("Facilitator registration") %></h1><p><%= bi("Complete six steps to apply as a Media Facilitator in your Grama Panchayat.") %></p><p><%= bi("Keep a recent photograph ready. Document requirements are shown during your application. Your draft stays available in this browser session for 24 hours.") %></p><% if(!registrationOpen){ %><p class="alert alert-info"><%= bi("New registration is currently closed. Existing drafts can still be resumed.") %></p><% } %><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="btn btn-primary" <%= !registrationOpen&&!hasDraft?'disabled':'' %>><%= bi(hasDraft?'Start or resume application':'Start application') %></button></form><% if(hasDraft){ %><p class="mt-3"><a href="/register/discard/"><%= bi("Discard unfinished draft") %></a></p><% } %><% if(hasApplication){ %><p><a href="/register/complete/"><%= bi("View submitted application") %></a></p><% } %><p class="mt-3"><a href="/accounts/login/"><%= bi("Staff sign in") %></a></p></section><%- include('footer') %>