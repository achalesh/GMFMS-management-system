<%- include('header') %><h1>Facilitator registry</h1><p><%= rows.length %> facilitators within your jurisdiction.</p><div class="panel table-responsive"><table class="table"><thead><tr><th>Number</th><th>Name</th><th>Panchayat</th><th>Role</th><th>Status</th><th>Valid until</th></tr></thead><tbody><% rows.forEach(f=>{ %><tr><td><a href="/facilitators/<%= f.id %>/"><%= f.number %></a></td><td><%= f.full_name %></td><td><%= f.panchayat_name %></td><td><%= f.role %></td><td><%= effectiveStatus(f) %></td><td><%= f.valid_until %></td></tr><% }) %></tbody></table><% if(!rows.length){ %><p>No facilitators yet.</p><% } %></div><%- include('footer') %>