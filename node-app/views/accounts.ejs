<%- include('header') %><h1>Accounts and roles</h1><p>New staff must change their initial password when signing in. Assign a role after creating an account.</p><section class="panel"><h2>User and role assignment</h2><ol><li>Create a staff account with an initial password of at least 12 characters.</li><li>Open the account below and assign a role and its location scope.</li><li>Share the username and initial password privately. The user must change the password on first login.</li></ol><p>Only a Super Admin can manage accounts and role assignments. Facilitator personal logins are allocated from the facilitator profile and cannot receive staff roles.</p><details><summary>Staff role guide</summary><table><thead><tr><th>Role</th><th>Access</th><th>Scope</th></tr></thead><tbody><tr><td>Super Admin</td><td>All administration, accounts, roles and application deletion</td><td>State</td></tr><tr><td>State Admin</td><td>Approval, facilitators, cards, reports, training, news, organization settings and audit</td><td>State</td></tr><tr><td>District Admin</td><td>Approval, facilitators, cards, reports, training and news</td><td>District</td></tr><tr><td>Block Coordinator</td><td>Review applications and news; manage training</td><td>Block</td></tr><tr><td>Reviewer</td><td>Review applications and news; view contacts and training</td><td>State, district or block</td></tr><tr><td>ID Card Operator</td><td>Issue cards; view facilitators, locations, dashboard and training</td><td>State, district or block</td></tr><tr><td>Viewer</td><td>View facilitators, locations, dashboard and training</td><td>State, district or block</td></tr></tbody></table></details></section><section class="panel"><h2>Create staff account</h2><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="action" value="create"><div class="report-filters"><% [['username','Username','text'],['email','Email','email'],['password','Initial password','password'],['confirm_password','Confirm initial password','password']].forEach(([key,label,type])=>{ %><div><label for="<%= key %>"><%= label %></label><input class="form-control" type="<%= type %>" name="<%= key %>" id="<%= key %>" required maxlength="<%= key==='username'?150:256 %>" <%- type==='password'?'minlength="12" autocomplete="new-password"':'' %>></div><% }) %></div><label class="mt-3" for="create-reason">Reason *</label><textarea class="form-control mb-3" name="reason" id="create-reason" maxlength="2000" required></textarea><button class="btn btn-primary">Create account</button></form></section><section class="panel mt-3"><label for="account-search">Find an account by username or email</label><input id="account-search" class="form-control" type="search" placeholder="Search accounts"><p id="account-count" aria-live="polite"></p></section><% users.forEach(account=>{ %><details class="panel mt-3" data-account><summary><strong><%= account.username %></strong> · <%= account.email %> · <%= account.active?'Active':'Inactive' %><%= account.superuser?' · Initial administrator':'' %><%= account.facilitator_id?' · Facilitator personal login':'' %></summary><% if(!account.facilitator_id){ %><h2 class="mt-4">Role assignments</h2><% scopes.filter(s=>s.user_id===account.id).forEach(s=>{ %><form method="post" class="mb-3"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="action" value="remove"><input type="hidden" name="user_id" value="<%= account.id %>"><input type="hidden" name="revision" value="<%= account.revision %>"><input type="hidden" name="assignment_id" value="<%= s.id %>"><p><%= s.role %> · <%= s.scope %> · <%= districts.find(d=>d.code===s.district_code)?.name||s.district_code||'' %> <%= blocks.find(b=>b.code===s.block_code)?.name||s.block_code||'' %></p><label>Removal reason *<input class="form-control" name="reason" required maxlength="2000"></label> <button class="btn btn-outline-danger">Remove role</button></form><% }) %><form method="post" data-role-assignment><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="action" value="assign"><input type="hidden" name="user_id" value="<%= account.id %>"><input type="hidden" name="revision" value="<%= account.revision %>"><div class="report-filters"><label>Role<select class="form-select" name="role"><% roles.forEach(role=>{ %><option><%= role %></option><% }) %></select></label><label>Scope<select class="form-select" name="scope"><option>STATE</option><option>DISTRICT</option><option>BLOCK</option></select></label><label>District<select class="form-select" name="district"><option value="">None (state scope)</option><% districts.forEach(d=>{ %><option value="<%= d.code %>"><%= d.name %></option><% }) %></select></label><label>Block<select class="form-select" name="block"><option value="">None (state / district scope)</option><% blocks.forEach(b=>{ %><option data-district="<%= b.district_code %>" value="<%= b.code %>"><%= b.name %> — <%= b.district_code %></option><% }) %></select></label></div><label>Assignment reason *<input class="form-control mb-3" name="reason" maxlength="2000" required></label><button class="btn btn-primary">Assign role</button></form><% } %><h2 class="mt-4">Account access</h2><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="action" value="active"><input type="hidden" name="user_id" value="<%= account.id %>"><input type="hidden" name="revision" value="<%= account.revision %>"><label class="consent"><input type="checkbox" name="active" <%= account.active?'checked':'' %>> Account active</label><label>Reason *<input class="form-control mb-3" name="reason" required maxlength="2000"></label><button class="btn btn-outline-primary">Update access</button></form><% if(account.id!==user.id){ %><h2 class="mt-4">Reset password</h2><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="action" value="password"><input type="hidden" name="user_id" value="<%= account.id %>"><input type="hidden" name="revision" value="<%= account.revision %>"><label>New initial password<input class="form-control mb-3" type="password" name="password" autocomplete="new-password" required minlength="12" maxlength="256"></label><label>Confirm password<input class="form-control mb-3" type="password" name="confirm_password" autocomplete="new-password" required maxlength="256"></label><label>Reset reason *<input class="form-control mb-3" name="reason" maxlength="2000" required></label><button class="btn btn-outline-danger">Reset password and end sessions</button></form><% } %></details><% }) %><script src="/static/js/accounts.js" defer></script><%- include('footer') %>