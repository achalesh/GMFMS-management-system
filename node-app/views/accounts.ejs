<%- include('header') %><h1>Staff accounts and roles</h1><p>New staff must change their initial password when signing in. Assign a role after creating an account.</p><section class="panel"><h2>Create staff account</h2><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="action" value="create"><div class="report-filters"><% [['username','Username','text'],['email','Email','email'],['password','Initial password','password'],['confirm_password','Confirm initial password','password']].forEach(([key,label,type])=>{ %><div><label for="<%= key %>"><%= label %></label><input class="form-control" type="<%= type %>" name="<%= key %>" id="<%= key %>" required maxlength="<%= key==='username'?150:256 %>" <%- type==='password'?'minlength="12" autocomplete="new-password"':'' %>></div><% }) %></div><label class="mt-3" for="create-reason">Reason *</label><textarea class="form-control mb-3" name="reason" id="create-reason" maxlength="2000" required></textarea><button class="btn btn-primary">Create account</button></form></section><% users.forEach(account=>{ %><details class="panel mt-3"><summary><strong><%= account.username %></strong> · <%= account.email %> · <%= account.active?'Active':'Inactive' %><%= account.superuser?' · Initial administrator':'' %></summary><h2 class="mt-4">Role assignments</h2><% scopes.filter(s=>s.user_id===account.id).forEach(s=>{ %><form method="post" class="mb-3"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="action" value="remove"><input type="hidden" name="user_id" value="<%= account.id %>"><input type="hidden" name="revision" value="<%= account.revision %>"><input type="hidden" name="assignment_id" value="<%= s.id %>"><p><%= s.role %> · <%= s.scope %> · <%= s.district_code||'' %> <%= s.block_code||'' %></p><label>Removal reason *<input class="form-control" name="reason" required maxlength="2000"></label> <button class="btn btn-outline-danger">Remove role</button></form><% }) %><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="action" value="assign"><input type="hidden" name="user_id" value="<%= account.id %>"><input type="hidden" name="revision" value="<%= account.revision %>"><div class="report-filters"><label>Role<select class="form-select" name="role"><% roles.forEach(role=>{ %><option><%= role %></option><% }) %></select></label><label>Scope<select class="form-select" name="scope"><option>STATE</option><option>DISTRICT</option><option>BLOCK</option></select></label><label>District<select class="form-select" name="district"><option value="">None (state scope)</option><% districts.forEach(d=>{ %><option value="<%= d.code %>"><%= d.name %></option><% }) %></select></label><label>Block<select class="form-select" name="block"><option value="">None (state / district scope)</option><% blocks.forEach(b=>{ %><option value="<%= b.code %>"><%= b.name %> — <%= b.district_code %></option><% }) %></select></label></div><label>Assignment reason *<input class="form-control mb-3" name="reason" maxlength="2000" required></label><button class="btn btn-primary">Assign role</button></form><h2 class="mt-4">Account access</h2><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="action" value="active"><input type="hidden" name="user_id" value="<%= account.id %>"><input type="hidden" name="revision" value="<%= account.revision %>"><label class="consent"><input type="checkbox" name="active" <%= account.active?'checked':'' %>> Account active</label><label>Reason *<input class="form-control mb-3" name="reason" required maxlength="2000"></label><button class="btn btn-outline-primary">Update access</button></form><% if(account.id!==user.id){ %><h2 class="mt-4">Reset password</h2><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="action" value="password"><input type="hidden" name="user_id" value="<%= account.id %>"><input type="hidden" name="revision" value="<%= account.revision %>"><label>New initial password<input class="form-control mb-3" type="password" name="password" autocomplete="new-password" required minlength="12" maxlength="256"></label><label>Confirm password<input class="form-control mb-3" type="password" name="confirm_password" autocomplete="new-password" required maxlength="256"></label><label>Reset reason *<input class="form-control mb-3" name="reason" maxlength="2000" required></label><button class="btn btn-outline-danger">Reset password and end sessions</button></form><% } %></details><% }) %><%- include('footer') %>