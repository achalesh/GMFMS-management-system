<%- include('header') %><section class="panel registration"><h1>Requested corrections</h1><p><%= ticket.message %></p><% if(error){ %><div class="alert alert-danger" role="alert"><%= error %></div><% } %><form method="post" enctype="multipart/form-data"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= ticket.revision %>"><input type="hidden" name="consent_version" value="<%= version %>"><%- include('form-fields',{fields,values}) %><% uploadSlots.forEach(slot=>{ %><label for="<%= slot %>"><%= slot.replace('doc_','').replaceAll('_',' ') %> — replacement file</label><input class="form-control mb-3" type="file" name="<%= slot %>" id="<%= slot %>" accept="<%= slot==='photo'?'.jpg,.jpeg,.png':'.jpg,.jpeg,.png,.pdf' %>"><% }) %><% if(uploadSlots.length){ %><p>Files may be up to 5 MB. A replacement photograph uses a centered portrait crop.</p><% } %><label class="consent"><input type="checkbox" name="accuracy" required> I confirm that the information provided is correct.</label><label class="consent"><input type="checkbox" name="processing" required> I consent to KGPA / Gramaswaraj storing and processing this information for Media Facilitator administration and identity verification.</label><p>Your existing optional public contact preferences remain unchanged. Consent version <%= version %>.</p><button class="btn btn-primary">Resubmit corrections</button></form></section><%- include('footer') %>