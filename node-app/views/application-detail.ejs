<%- include('header') %><a href="/applications/">← Applications</a><section class="panel mt-3"><p class="eyebrow"><%= application.number %> · <%= application.status.replaceAll('_',' ') %></p><h1><%= application.full_name %></h1><p><%= application.panchayat_name %></p><% if(facilitator){ %><div class="alert alert-success">Approved as <strong><%= facilitator.number %></strong> (<%= facilitator.role %>), valid until <%= facilitator.valid_until %>.</div><% } %><% if(warnings){ %><div class="alert alert-warning"><%= warnings %> possible duplicate application(s) found by mobile, email, or matching name and panchayat. Review the records before approval.</div><% } %><% [2,3,4].forEach(step=>{ %><dl class="review-data"><% fields[step].forEach(f=>{if(step===2&&!canContacts&&!['full_name','name_ml'].includes(f.name))return;const value=application.data[step][f.name]; %><dt><%= f.label %></dt><dd><%= Array.isArray(value)?value.join(', '):value||'—' %></dd><% }) %></dl><% }) %><% if(canContacts){ %><h2>Private files</h2><% uploads.forEach(u=>{ %><p><a href="/applications/<%= application.id %>/files/<%= u.slot %>"><%= u.slot.replace('doc_','') %></a></p><% }) %><h2>Recorded consent</h2><p>Version <%= application.data.consent.version %>, recorded <%= new Date(application.data.consent.at).toISOString() %>.</p><% Object.entries(catalog.CONSENT).forEach(([key,label])=>{const name=['accuracy','processing'].includes(key)?key:'public_'+key; %><p><strong><%= application.data.consent[name]?'Yes':'No' %></strong> — <%= label %></p><% }) %><% } %></section>
<% if(application.status==='SUBMITTED'&&canReview||application.status==='UNDER_REVIEW'&&canApprove){ %><section class="panel mt-4"><h2>Review action</h2><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= application.revision %>"><% if(application.status==='SUBMITTED'){ %><button class="btn btn-primary" name="action" value="start_review">Start review</button><% }else{ %><label for="reason">Decision reason (required for rejection or duplicate approval)</label><textarea class="form-control mb-3" id="reason" name="reason" maxlength="2000" rows="3"></textarea><label for="role">Appointment role</label><select class="form-select mb-3" name="role" id="role"><option>PRIMARY</option><option>ASSISTANT</option><option>ADDITIONAL</option></select><label class="consent"><input type="checkbox" name="verified"> I have verified the application details, documents and consent.</label><% if(warnings){ %><label class="consent"><input type="checkbox" name="acknowledge"> I reviewed the duplicate warnings and explained my decision.</label><% } %><button class="btn btn-primary mt-3" name="action" value="approve">Approve appointment</button> <button class="btn btn-outline-danger mt-3" name="action" value="reject">Reject application</button><% } %></form></section><% } %><section class="panel mt-4"><h2>Review history</h2><% events.forEach(e=>{ %><p><strong><%= e.action.replaceAll('_',' ') %></strong> · <%= new Date(e.created_at).toISOString() %><br><%= e.from_status %> → <%= e.to_status %><br><%= e.reason %></p><% }) %><% if(!events.length){ %><p>No review actions yet.</p><% } %></section><% if(canReview&&['UNDER_REVIEW','CORRECTION_REQUIRED'].includes(application.status)){ %><section class="panel mt-4"><h2>Applicant corrections</h2><form method="post" action="/applications/<%= application.id %>/correction/"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= application.revision %>"><label for="correction-reason">Instructions / reason *</label><textarea class="form-control mb-3" name="reason" id="correction-reason" maxlength="2000" required></textarea><% if(application.status==='UNDER_REVIEW'){ %><fieldset><legend class="fs-6">Fields the applicant may correct</legend><div class="choices"><% correctionChoices.forEach(([key,label])=>{ %><label><input type="checkbox" name="allowed_fields" value="<%= key %>"><%= label %></label><% }) %></div></fieldset><button class="btn btn-primary mt-3" name="action" value="request_correction">Create correction link</button><% }else{ %><button class="btn btn-primary" name="action" value="renew_correction">Renew correction link</button> <button class="btn btn-outline-secondary" name="action" value="cancel_correction">Cancel correction request</button><% } %></form></section><% } %><%- include('footer') %>