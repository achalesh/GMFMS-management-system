<%- include('header') %><section class="panel login"><h1>Delete rejected application</h1><p>Reference: <strong><%= application.number %></strong></p><p>This permanently removes the application, its personal details, documents, draft, correction links and review history. Its mobile number and email become available for registration again. Only a minimal deletion audit record remains.</p><% if(error){ %><p class="alert alert-danger" role="alert"><%= error %></p><% } %><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= application.revision %>"><label for="delete-reason">Deletion reason *</label><select class="form-select mb-3" name="reason" id="delete-reason" required><option value="">Choose reason</option><% reasons.forEach(reason=>{ %><option><%= reason %></option><% }) %></select><label for="delete-reference">Type the application reference to confirm *</label><input class="form-control" id="delete-reference" name="reference" autocomplete="off" required><label class="consent"><input type="checkbox" name="confirmed" required> I understand this deletion cannot be undone.</label><button class="btn btn-danger">Permanently delete application</button> <a class="btn btn-outline-secondary" href="/applications/<%= application.id %>/">Keep application</a></form></section><%- include('footer') %>
