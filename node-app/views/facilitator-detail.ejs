<%- include('header') %><a href="/facilitators/">← Registry</a><section class="panel mt-3"><p class="eyebrow"><%= f.number %></p><h1><%= f.full_name %></h1><p><a href="/facilitators/<%= f.id %>/cards/">Verification and ID cards</a></p><p><%= f.panchayat_name %> · <%= f.role %> · <strong><%= effectiveStatus(f) %></strong></p><p>Valid until <%= f.valid_until %><%= f.ended?' · Appointment ended':'' %></p><p>Appointment reference: <%= f.reference||'—' %></p><p><%= f.notes %></p></section>
<% if(change&&!['REVOKED','REPLACED'].includes(f.status)){ %><section class="panel mt-4"><h2>Update facilitator</h2><p>Every change requires a reason and is recorded in the history.</p><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= f.revision %>"><label for="action">Action</label><select class="form-select mb-3" name="action" id="action"><% [['details','Edit reference / notes'],['suspend','Suspend'],['inactivate','Mark inactive'],['resign','Record resignation'],['revoke','Revoke permanently'],['reactivate','Reactivate'],['renew','Renew validity'],['transfer','Transfer panchayat'],['role','Change role']].forEach(([key,label])=>{ %><option value="<%= key %>"><%= label %></option><% }) %></select><label for="reason">Reason *</label><textarea class="form-control mb-3" name="reason" id="reason" maxlength="2000" required></textarea><label for="reference">Appointment reference (edit details)</label><input class="form-control mb-3" name="reference" id="reference" maxlength="150" value="<%= f.reference %>"><label for="notes">Notes (edit details)</label><textarea class="form-control mb-3" name="notes" id="notes" maxlength="2000"><%= f.notes %></textarea><label for="valid_until">New expiry (renewal)</label><input class="form-control mb-3" type="date" name="valid_until" id="valid_until"><label for="panchayat">Destination panchayat (transfer)</label><select class="form-select mb-3" name="panchayat" id="panchayat"><% locations.forEach(l=>{ %><option value="<%= l.code %>" <%= l.code===f.panchayat_code?'selected':'' %>><%= l.name %> — <%= l.district_code %></option><% }) %></select><label for="role">New role (role change)</label><select class="form-select mb-3" name="role" id="role"><% ['PRIMARY','ASSISTANT','ADDITIONAL'].forEach(role=>{ %><option <%= role===f.role?'selected':'' %>><%= role %></option><% }) %></select><button class="btn btn-primary">Save change</button></form></section>
<% if(f.role==='PRIMARY'&&!f.ended&&candidates.length){ %><section class="panel mt-4"><h2>Replace primary facilitator</h2><p>The current identity becomes historical only if the replacement approval succeeds.</p><% candidates.forEach(c=>{ %><form method="post" class="mb-4"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= f.revision %>"><input type="hidden" name="action" value="replace"><input type="hidden" name="replacement_id" value="<%= c.id %>"><input type="hidden" name="application_revision" value="<%= c.revision %>"><p><a href="/applications/<%= c.id %>/"><%= c.number %> · <%= c.full_name %></a></p><label>Replacement reason *<textarea class="form-control" name="reason" maxlength="2000" required></textarea></label><label class="consent"><input type="checkbox" name="verified" required> I verified the candidate’s details, documents and consent.</label><label class="consent"><input type="checkbox" name="acknowledge"> I reviewed any duplicate warnings and explained the decision.</label><button class="btn btn-outline-danger">Replace with this applicant</button></form><% }) %></section><% } %><% } %><section class="panel mt-4"><h2>History</h2><p>Approved <%= new Date(f.approved_at).toISOString() %>.</p><% history.forEach(h=>{const changes=JSON.parse(h.snapshot); %><article class="mb-4"><strong><%= h.action %></strong> · <%= new Date(h.created_at).toISOString() %><p><%= h.reason %></p><p><%= changes.old.status %> → <%= changes.new.status %> · <%= changes.old.panchayat_code %> → <%= changes.new.panchayat_code %> · <%= changes.old.role %> → <%= changes.new.role %></p></article><% }) %></section><%- include('footer') %>