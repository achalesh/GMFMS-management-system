<%- include('header') %><a href="/facilitators/<%= f.id %>/">← Facilitator</a><section class="panel mt-3"><h1>Verification and ID cards</h1><p><%= f.full_name %> · <%= f.number %></p><% if(url){ %><p><a href="<%= url %>" rel="noreferrer">Open public verification</a> · <a href="/facilitators/<%= f.id %>/qr/">Download QR code</a></p><% } %><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= f.revision %>"><label for="issue-reason">Reason *</label><textarea class="form-control mb-3" id="issue-reason" name="reason" required maxlength="2000"></textarea><button class="btn btn-primary" name="action" value="issue">Generate new card version</button><% if(!url){ %> <button class="btn btn-outline-primary" name="action" value="create_link">Create verification link only</button><% } %></form></section><% if(url&&canChange){ %><details class="panel mt-4"><summary>Replace verification link</summary><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= f.revision %>"><input type="hidden" name="action" value="rotate"><label>Reason *<textarea class="form-control" name="reason" required maxlength="2000"></textarea></label><label class="consent"><input type="checkbox" name="confirmed" required> Existing verification links and printed QR codes will stop working.</label><button class="btn btn-outline-danger">Replace link</button></form></details><% } %><% cards.forEach(card=>{ %><section class="panel mt-4"><h2><%= card.number %></h2><p><strong><%= card.state %></strong> · Issued <%= card.issued_on %> · Valid until <%= card.valid_until %></p><% if(card.state==='CURRENT'){ %><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= f.revision %>"><input type="hidden" name="card_id" value="<%= card.id %>"><input type="hidden" name="action" value="download"><label>Download / reprint reason *<input class="form-control mb-3" name="reason" required maxlength="2000"></label><p><button class="btn btn-primary" name="format" value="pdf">Download card PDF</button> <button class="btn btn-outline-primary" name="format" value="print_pdf">Download A4 print sheet</button></p></form><% } %><% if(card.status==='ISSUED'&&canChange){ %><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= f.revision %>"><input type="hidden" name="card_id" value="<%= card.id %>"><input type="hidden" name="action" value="revoke"><label>Revocation reason *<input class="form-control" name="reason" required maxlength="2000"></label> <button class="btn btn-outline-danger">Revoke card</button></form><% } %></section><% }) %><section class="panel mt-4"><h2>Card history</h2><% events.forEach(e=>{ %><p><strong><%= e.action %></strong> · <%= new Date(e.created_at).toISOString() %><br><%= e.reason %></p><% }) %></section><%- include('footer') %>