<%- include('header') %><h1>Applications</h1><p><%= rows.length %> applications within your jurisdiction.</p><form method="get" action="/applications/" class="panel">
<div class="form-grid">
<label>Sort by<select name="sort"><% sortOptions.forEach(([value,label])=>{ %><option value="<%= value %>" <%= sort===value?'selected':'' %>><%= label %></option><% }) %></select></label>
<label>Order<select name="direction"><option value="asc" <%= direction==='asc'?'selected':'' %>>Ascending (A–Z / oldest first)</option><option value="desc" <%= direction==='desc'?'selected':'' %>>Descending (Z–A / newest first)</option></select></label>
</div><button type="submit" class="button">Apply sorting</button> <a href="/applications/">Reset</a>
</form><div class="panel table-responsive"><table class="table"><thead><tr><th>Reference</th><th>Name</th><th>Panchayat</th><th>Status</th></tr></thead><tbody><% rows.forEach(a=>{ %><tr><td><a href="/applications/<%= a.id %>/"><%= a.number %></a></td><td><%= a.full_name %></td><td><%= a.panchayat_name %></td><td><%= a.status.replaceAll('_',' ') %></td></tr><% }) %></tbody></table><% if(!rows.length){ %><p>No applications yet.</p><% } %></div><%- include('footer') %>