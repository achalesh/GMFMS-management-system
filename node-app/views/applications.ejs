<%- include('header') %><h1>Applications</h1><p><%= rows.length %> applications within your jurisdiction.</p><div class="panel table-responsive"><table class="table"><thead><tr><th>Reference</th><th>Name</th><th>Panchayat</th><th>Status</th></tr></thead><tbody><% rows.forEach(a=>{ %><tr><td><a href="/applications/<%= a.id %>/"><%= a.number %></a></td><td><%= a.full_name %></td><td><%= a.panchayat_name %></td><td><%= a.status.replaceAll('_',' ') %></td></tr><% }) %></tbody></table><% if(!rows.length){ %><p>No applications yet.</p><% } %></div><%- include('footer') %>