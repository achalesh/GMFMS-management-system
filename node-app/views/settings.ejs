<%- include('header') %><a href="/administration/">← Administration</a><section class="panel mt-3"><h1><%= kind==='organization'?'Organization settings':'Registration and privacy policy' %></h1><% if(error){ %><div class="alert alert-danger" role="alert"><%= error %></div><% } %><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= value.revision %>"><% if(kind==='organization'){ %><div class="report-filters"><% [['application_name','Application name',160],['short_name','Brand name',30],['name','Organization name',180],['network_name','Network name',180],['address','Address',1500],['phone','Organization phone',30],['email','Organization email',254],['website','Website',250],['signatory_name','Signatory name',120]].forEach(([key,label,max])=>{ %><div><label for="<%= key %>"><%= label %></label><input class="form-control <%= errorField===key?'is-invalid':'' %>" type="<%= key==='email'?'email':key==='website'?'url':'text' %>" <%= ['application_name','short_name','name','network_name'].includes(key)?'required':'' %> name="<%= key %>" id="<%= key %>" maxlength="<%= max %>" value="<%= value.data[key] %>" <%- key==='website'?'aria-describedby="website-help website-error"':'' %>><% if(key==='website'){ %><small id="website-help" class="form-text">Include https://, for example https://gramaswaraj.in. Leave blank if unavailable.</small><div id="website-error" class="invalid-feedback" aria-live="polite"><%= errorField==='website'?error:'Enter an HTTP or HTTPS website without embedded credentials.' %></div><% } %></div><% }) %></div><p class="mt-3">Changes to printed branding make existing cards outdated. Generate a new version after updating card details.</p><% }else{ %><label class="consent"><input type="checkbox" name="registration_open" <%= value.data.registration_open?'checked':'' %>> Accept new registrations (existing drafts and correction requests continue)</label><div class="report-filters"><% [['prefix','Facilitator ID prefix'],['validity_days','Default validity in days'],['consent_version','Consent version']].forEach(([key,label])=>{ %><div><label for="<%= key %>"><%= label %></label><input class="form-control" id="<%= key %>" name="<%= key %>" value="<%= policy[key] %>" required maxlength="30"></div><% }) %></div><fieldset class="mt-4"><legend class="fs-6">Required supporting documents</legend><% catalog.DOCUMENTS.forEach(([code,label])=>{ %><label class="consent"><input type="checkbox" name="required_documents" value="<%= code %>" <%= value.data.required_documents.includes(code)?'checked':'' %>><%= label %></label><% }) %></fieldset><p>Photographs remain required. Each upload is limited to 5 MB.</p><h2>Public contact publication</h2><p>Contacts appear only for an active identity with the applicant’s separate consent. A revoked or outdated card never publishes contacts.</p><% [['allow_public_mobile','Allow consented mobile numbers'],['allow_public_email','Allow consented email addresses'],['allow_public_social','Allow consented social profiles']].forEach(([key,label])=>{ %><label class="consent"><input type="checkbox" name="<%= key %>" <%= value.data[key]?'checked':'' %>><%= label %></label><% }) %><% } %><label class="mt-4" for="reason">Reason for change *</label><textarea class="form-control mb-3" id="reason" name="reason" maxlength="2000" required><%= reason %></textarea><button class="btn btn-primary">Save settings</button></form></section><% if(kind==='organization'){ %><script src="/static/js/settings-validation.js" defer></script><% } %><%- include('footer') %>