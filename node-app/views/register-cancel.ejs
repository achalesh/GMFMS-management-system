<%- include('header') %><section class="panel login"><h1><%= bi(kind==='discard'?'Discard draft':'Withdraw application') %></h1><% if(error){ %><p class="alert alert-danger" role="alert"><%= error %><br><span lang="ml">നൽകിയ വിവരങ്ങൾ പരിശോധിച്ച് ആവശ്യമായ തിരുത്തലുകൾ വരുത്തുക.</span></p><% } %><p><%= bi(kind==='discard'?'Your unfinished draft and uploaded files will be permanently removed. You can start a new application.':'Your application will leave the review queue. The registration and its documents will be retained with the withdrawal history.') %></p><% if(number){ %><p>Reference: <strong><%= number %></strong></p><% } %><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= revision %>"><% if(kind==='withdraw'){ %><label for="reason"><%= bi("Withdrawal reason") %> *</label><textarea class="form-control" id="reason" name="reason" required maxlength="2000"><%= reason %></textarea><% } %><label class="consent"><input type="checkbox" name="confirmed" required> I confirm I want to / ഞാൻ സ്ഥിരീകരിക്കുന്നു: <%= bi(kind==='discard'?'discard this draft':'withdraw this application') %>.</label><button class="btn btn-danger"><%= bi(kind==='discard'?'Confirm discard':'Confirm withdrawal') %></button> <a class="btn btn-outline-secondary" href="<%= kind==='discard'?'/register/':'/register/complete/' %>"><%= bi("Keep registration") %></a></form></section><%- include('footer') %>
