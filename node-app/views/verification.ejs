<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Gramaswaraj identity verification</title><link rel="stylesheet" href="/static/vendor/bootstrap.min.css"><link rel="stylesheet" href="/static/css/preview.css"></head><body><main class="container py-4"><section class="panel login"><img class="portrait" src="/static/img/gramaswaraj-logo.png" alt="Gramaswaraj"><h1>Identity verification</h1><p><%= profile.organization %></p><div class="alert <%= profile.is_authorized?'alert-success':'alert-danger' %>"><strong><%= profile.is_authorized?'Verified Media Facilitator':'Not currently authorized' %></strong><br><%= profile.status %><% if(profile.card){ %> · Card: <%= profile.card.status %><% } %></div><img class="portrait" src="<%= profile.portrait_url %>" alt="Facilitator photograph"><h2><%= profile.name %></h2><p><%= profile.facilitator_id %> · <%= profile.role %></p><p><%= profile.panchayat %> Grama Panchayat<br><%= profile.block %> Block<br><%= profile.district %></p><p>Valid until <%= profile.valid_until %></p><% if(profile.card){ %><p>Card <%= profile.card.number %><br>Issued <%= profile.card.issued_on %></p><% } %><% if(profile.mobile){ %><p>Mobile: <%= profile.mobile %></p><% } %><% if(profile.email){ %><p>Email: <%= profile.email %></p><% } %><% if(profile.social_profiles){ %><% Object.entries(profile.social_profiles).forEach(([label,url])=>{ %><p><a href="<%= url %>" rel="noreferrer"><%= label %></a></p><% }) %><% } %><p>Verify the photograph and current status before accepting this identity.</p></section></main></body></html>