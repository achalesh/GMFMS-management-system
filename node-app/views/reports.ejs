<%- include('header') %><h1>Reports</h1><p>Filter records within your permitted jurisdiction. Coverage and vacancies show the current position.</p><section class="panel"><% if(error){ %><div class="alert alert-danger" role="alert"><%= error %></div><% } %><form method="get"><div class="report-filters"><div><label for="report">Report</label><select class="form-select" id="report" name="report"><% Object.entries(reportKinds).forEach(([key,label])=>{ %><option value="<%= key %>" <%= report.filters.report===key?'selected':'' %>><%= label %></option><% }) %></select></div><% const districtOptions=[...new Map(report.options.map(p=>[p.district_code,p])).values()];const blockOptions=[...new Map(report.options.map(p=>[p.block_code,p])).values()];[['district','District',districtOptions,'district_code','district_name'],['block','Block',blockOptions,'block_code','block_name'],['panchayat','Panchayat',report.options,'code','name']].forEach(([key,label,options,code,name])=>{ %><div><label for="<%= key %>"><%= label %></label><select class="form-select" name="<%= key %>" id="<%= key %>"><option value="">All permitted <%= label.toLowerCase() %>s</option><% options.forEach(p=>{ %><option value="<%= p[code] %>" <%= report.filters[key]===p[code]?'selected':'' %>><%= p[name] %><%= key!=='district'?' — '+p.district_name:'' %></option><% }) %></select></div><% }) %><div><label for="status">Status</label><select class="form-select" id="status" name="status"><option value="">All statuses</option><% statuses.forEach(status=>{ %><option <%= report.filters.status===status?'selected':'' %>><%= status %></option><% }) %></select></div><div><label for="role">Role</label><select class="form-select" id="role" name="role"><option value="">All roles</option><% ['PRIMARY','ASSISTANT','ADDITIONAL'].forEach(role=>{ %><option <%= report.filters.role===role?'selected':'' %>><%= role %></option><% }) %></select></div><div><label for="date_field">Date filter</label><select class="form-select" name="date_field" id="date_field"><% [['registration','Registration date'],['approval','Approval date'],['expiry','Expiry date']].forEach(([key,label])=>{ %><option value="<%= key %>" <%= report.filters.date_field===key?'selected':'' %>><%= label %></option><% }) %></select></div><% ['start','end'].forEach(key=>{ %><div><label for="<%= key %>"><%= key==='start'?'From date':'To date' %></label><input class="form-control" type="date" name="<%= key %>" id="<%= key %>" value="<%= report.filters[key]||'' %>"></div><% }) %></div><button class="btn btn-primary mt-3">Apply filters</button> <a href="/reports/" class="btn btn-outline-secondary mt-3">Reset</a></form></section><section class="panel mt-4"><h2><%= report.title %></h2><p><%= total %> rows · Page <%= page %> of <%= pages %></p><div class="table-responsive"><table class="table"><thead><tr><% report.headers.forEach(header=>{ %><th><%= header %></th><% }) %></tr></thead><tbody><% rows.forEach(row=>{ %><tr><% row.forEach(value=>{ %><td><%= value %></td><% }) %></tr><% }) %></tbody></table><% if(!rows.length){ %><p>No records match these filters.</p><% } %></div><nav class="pagination-links" aria-label="Report pages"><% if(page>1){ %><a href="/reports/?<%= query %>&page=<%= page-1 %>">Previous</a><% } %><% if(page<pages){ %><a href="/reports/?<%= query %>&page=<%= page+1 %>">Next</a><% } %></nav></section><% if(canExport&&!error){ %><section class="panel mt-4"><h2>Download report</h2><p>Downloads use your export jurisdiction. PDF supports up to 500 rows; Excel and CSV support up to 10,000 records.</p><form method="post" action="/reports/?<%= query %>"><input type="hidden" name="csrf" value="<%= csrf %>"><label for="format">Format</label><select class="form-select mb-3" name="format" id="format"><option value="xlsx">Excel</option><option value="csv">CSV</option><option value="pdf">PDF</option></select><label for="export-reason">Reason for export *</label><textarea class="form-control mb-3" name="reason" id="export-reason" maxlength="500" required></textarea><button class="btn btn-primary">Download report</button></form></section><% } %><%- include('footer') %>