<%- include('header') %><section class="panel login"><h1>Change password</h1><p>Use a new password with at least 12 characters. You will sign in again afterward.</p><% if(error){ %><p class="alert alert-danger" role="alert"><%= error %></p><% } %><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><label for="current_password">Current password</label><input class="form-control mb-3" type="password" id="current_password" name="current_password" autocomplete="current-password" required maxlength="256"><label for="password">New password</label><input class="form-control mb-3" type="password" id="password" name="password" autocomplete="new-password" minlength="12" maxlength="256" required><label for="confirm_password">Confirm new password</label><input class="form-control mb-3" type="password" id="confirm_password" name="confirm_password" autocomplete="new-password" required maxlength="256"><button class="btn btn-primary">Change password</button></form></section><%- include('footer') %>