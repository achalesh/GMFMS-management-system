<%- include('header') %><section class="panel registration"><p class="eyebrow">FACILITATOR REGISTRATION / ഫെസിലിറ്റേറ്റർ രജിസ്ട്രേഷൻ · STEP <%= step %> OF 6 / ഘട്ടം <%= step %> / 6</p><h1><%= bi(titles[step-1]) %></h1><nav class="steps" aria-label="Registration steps"><% titles.forEach((title,i)=>{ %><% if(i+1<=draft.completed+1){ %><a href="/register/<%= i+1 %>/" <%- i+1===step?'aria-current="step"':'' %>><%= i+1 %>. <%= bi(title) %></a><% }else{ %><span aria-disabled="true"><%= i+1 %>. <%= bi(title) %></span><% } %><% }) %></nav><% if(error){ %><div class="alert alert-danger" role="alert"><%= error %><br><span lang="ml">നൽകിയ വിവരങ്ങൾ പരിശോധിച്ച് ആവശ്യമായ തിരുത്തലുകൾ വരുത്തുക.</span></div><% } %><form method="post" <% if(step===5){ %>enctype="multipart/form-data"<% } %>><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= draft.revision %>">
<% if(step===1){ const districts=[...new Map(locations.map(l=>[l.district_code,l])).values()];const blocks=[...new Map(locations.map(l=>[l.block_code,l])).values()]; %>
<label for="district"><%= bi("District") %> *</label><select class="form-select mb-3" id="district" name="district" required><option value=""><%= bi("Choose district") %></option><% districts.forEach(l=>{ %><option value="<%= l.district_code %>" <%= values.district===l.district_code?'selected':'' %>><%= l.district_name %></option><% }) %></select>
<label for="block"><%= bi("Block") %> *</label><select class="form-select mb-3" id="block" name="block" required><option value=""><%= bi("Choose block") %></option><% blocks.forEach(l=>{ %><option data-district="<%= l.district_code %>" value="<%= l.block_code %>" <%= values.block===l.block_code?'selected':'' %>><%= l.block_name %> — <%= l.district_name %></option><% }) %></select>
<label for="panchayat"><%= bi("Grama Panchayat") %> *</label><select class="form-select mb-4" id="panchayat" name="panchayat" required><option value=""><%= bi("Choose panchayat") %></option><% locations.forEach(l=>{ %><option data-block="<%= l.block_code %>" value="<%= l.code %>" <%= values.panchayat===l.code?'selected':'' %>><%= l.name %> — <%= l.block_name %></option><% }) %></select><script src="/static/js/registration.js" defer></script>
<% }else if(step<5){ %><% if(step===2){ %><p><%= bi("Mobile numbers and email addresses must be unique across registrations. Contact the administrator if your details are already registered.") %></p><% } %><%- include('form-fields',{fields,values}) %>
<% }else if(step===5){ %><p><%= bi("JPG or PNG photographs; JPG, PNG or PDF supporting documents. Maximum 5 MB per file. Photograph must be at least 100 \u00d7 100 pixels. Files remain private.") %></p><label for="photo"><%= bi("Profile photograph") %> *</label><input class="form-control mb-3" type="file" name="photo" id="photo" accept=".jpg,.jpeg,.png" <%= uploads.includes('photo')?'':'required' %>><% if(uploads.includes('photo')){ %><img class="portrait" src="/register/files/photo" alt="Your saved profile photograph"><p><%= bi("Leave the file blank to keep your saved photograph.") %></p><% } %><fieldset class="mb-4"><legend class="fs-6"><%= bi("Photograph crop (applies when uploading a new photo)") %></legend><% [['crop_x','Horizontal position',0,100,50],['crop_y','Vertical position',0,100,50],['crop_zoom','Zoom',1,3,1]].forEach(([name,label,min,max,value])=>{ %><label for="<%= name %>"><%= bi(label) %></label><input class="form-control mb-2" type="number" step="0.1" id="<%= name %>" name="<%= name %>" min="<%= min %>" max="<%= max %>" value="<%= value %>"><% }) %></fieldset><% catalog.DOCUMENTS.forEach(([code,label])=>{const slot='doc_'+code; %><label for="<%= slot %>"><%= bi(label) %> (<%= bi(requiredDocuments.includes(code)?'required':'optional') %>)</label><input class="form-control mb-2" type="file" id="<%= slot %>" name="<%= slot %>" accept=".pdf,.jpg,.jpeg,.png"><% if(uploads.includes(slot)){ %><p><a href="/register/files/<%= slot %>"><%= bi("Download saved document") %></a> · <label><input type="checkbox" name="remove_<%= slot %>"> Remove document</label></p><% } %><% }) %>
<% }else{ %><p><%= bi("Check your details before submitting. Use the step tabs above to make changes.") %></p><% Object.entries(draft.data).forEach(([section,data])=>{ %><h2 class="mt-4"><%= bi(titles[Number(section)-1]) %></h2><dl class="review-data"><% Object.entries(data).forEach(([key,value])=>{ %><dt><%= bi(section==='1'?({district:'District',block:'Block',panchayat:'Grama Panchayat'}[key]||key):(fields.find(f=>f.name===key)?.label||key.replaceAll('_',' '))) %></dt><dd><%= section==='1'?(reviewLocation[key]||'Location unavailable — return to the Location tab'):(Array.isArray(value)?value.join(', '):value||'—') %></dd><% }) %></dl><% }) %><h2><%= bi("Photograph and documents") %></h2><% uploads.forEach(slot=>{ %><p><a href="/register/files/<%= slot %>"><%= slot.replace('doc_','').replaceAll('_',' ') %></a></p><% }) %><input type="hidden" name="consent_version" value="<%= version %>"><input type="hidden" name="website" value=""><h2 class="mt-4"><%= bi("Declaration and consent") %></h2><p>Consent version <%= version %>. Public contact sharing is optional. / സമ്മതപത്ര പതിപ്പ് <%= version %>. ബന്ധപ്പെടാനുള്ള വിവരങ്ങൾ പൊതുവായി പങ്കിടുന്നത് ഐച്ഛികമാണ്.</p><% Object.entries(catalog.CONSENT).forEach(([key,label])=>{const required=['accuracy','processing'].includes(key),name=required?key:'public_'+key; %><label class="consent"><input type="checkbox" name="<%= name %>" <%= required?'required':'' %>> <%= bi(label) %><%= required?' *':'' %></label><% }) %>
<% } %><div class="mt-4"><button class="btn btn-primary"><%= bi(step===6?'Submit application':'Save and continue') %></button></div></form><p class="mt-4"><a class="btn btn-outline-danger" href="/register/discard/"><%= bi("Discard draft") %></a></p></section><%- include('footer') %>