# Copy to .env for LOCAL DEVELOPMENT. Production uses config.settings.production.
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
# Generate a unique key using the command in INSTALLATION.md. Never use a sample key.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DATABASE_URL=sqlite:///db.sqlite3
PUBLIC_BASE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.invalid
# Relative paths are resolved from the project directory.
MEDIA_ROOT=private_media
STATIC_ROOT=staticfiles
SESSION_COOKIE_AGE=1800
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
# Only enable behind a trusted proxy that overwrites X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=False

